6:["$","div",null,{"className":"space-y-4","id":"step4","children":[["$","h4",null,{"children":"Ideation Process"}],["$","div",null,{"className":"space-y-4 content-width","children":[["$","h3",null,{"children":"Re-evaluating the User Journey"}],["$","p",null,{"children":"The current design journey is comprised of three separate flows- one for checking degree requirements, one for checking availability of courses, and one for plotting their timetables. This split-up system creates potential for miscommunication and a chance for students to fail to maintain degree requirements."}],["$","p",null,{"children":"To fix this, the new flow should allow for students to easily change between each flow, allowing for a single experience and prevent user error."}],["$","p",null,{"children":"After finalizing this new system, I could now start designing the mid-fidelity screens."}]]}],["$","div",null,{"className":"gap-4 my-4","children":[["$","img",null,{"className":"greyborder ","src":"/images/handbook/currentjourney.png"}],["$","img",null,{"className":"greyborder ","src":"/images/handbook/revisedjourney.png"}]]}]]}]
7:["$","div",null,{"className":"space-y-4","id":"step5","children":[["$","h4",null,{"children":"User Feedback"}],["$","div",null,{"className":"space-y-4 content-width","children":[["$","h3",null,{"children":"Mid-Fidelity to Hi-Fidelity"}],["$","p",null,{"children":"Based on my research, I developed a mid-fidelity prototype that addressed the revised user journey, consolidating all major flows into a single dashboard. The dashboard used a central sidebar system to allow users to navigate between their different flows, and"}]]}],["$","img",null,{"className":"greyborder my-4 full","src":"/images/handbook/Wireframes.png"}],["$","div",null,{"className":"space-y-4","children":[["$","p",null,{"children":["To test the prototype, I asked ",["$","b",null,{"children":"three design students who hadn't used the app"}]," to:"]}],["$","ol",null,{"children":[["$","li",null,{"children":["$","h3",null,{"children":["$","b",null,{"children":"Add a course to their first-year schedule."}]}]}],["$","li",null,{"children":["$","h3",null,{"children":["$","b",null,{"children":"Check which credits they still needed."}]}]}],["$","li",null,{"children":["$","h3",null,{"children":["$","b",null,{"children":"Create a timetable for one year."}]}]}]]}],["$","p",null,{"children":"Since these three flows were most important to students, my goal was to make them as simple and intuitive as possible."}],["$","p",null,{"children":"Here are the insights gained from this testing:"}]]}],["$","div",null,{"className":"space-y-4","children":[["$","h4",null,{"children":"Design Changes"}],["$","div",null,{"className":"space-y-4","children":[["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":[["$","div",null,{"className":"space-y-4","children":[["$","h3",null,{"children":"Course Card Design"}],["$","p",null,{"children":"User testing showed that course cards lacked clarity and essential details, such as when a course was offered. Based on feedback, I redesigned the cards with clearer organization and added labels to show which requirements each course fulfills."}]]}],["$","div",null,{"children":["$","img",null,{"className":"greyborder full","src":"/images/handbook/desnbookcard.png"}]}]]}],["$","div",null,{"className":"header-border"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":[["$","div",null,{"className":"space-y-4","children":[["$","h3",null,{"children":"Suggestion Sidebar"}],["$","p",null,{"children":"Users wanted the sidebar to be more functional. Early versions displayed only credit totals without actionable suggestions. The improved version includes recommendations and quick fixes students can apply with one click."}]]}],["$","div",null,{"children":["$","img",null,{"className":"greyborder full","src":"/images/handbook/sidebarimage.png"}]}]]}]]}]]}]]}]
