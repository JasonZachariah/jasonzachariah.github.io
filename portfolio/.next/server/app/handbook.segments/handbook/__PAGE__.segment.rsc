3:["$","div",null,{"className":"important-bg space-y-8","children":[["$","div",null,{"className":"space-y-4","children":[["$","h4",null,{"children":"HMW STATEMENT"}],["$","h2",null,{"children":"How do we make the process of planning out DESN student requirements a simplified, single experience?"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":[["$","div",null,{"className":"space-y-4 greyborder p-4","children":[["$","p",null,{"className":"caption-lg","children":"Confusion over course requirements"}],["$","p",null,{"children":"The current design handbook lacks support for showing how courses affect degree, leaving students lost when planning their degrees."}]]}],["$","div",null,{"className":"space-y-4 greyborder p-4","children":[["$","p",null,{"className":"caption-lg","children":"Planning your degree is tedious"}],["$","p",null,{"children":"The current process requires students to use multiple disconnected platforms to follow degree requirements, leading to a workflow prone to errors"}]]}]]}]]}]
4:["$","div",null,{"className":"space-y-4 ","children":[["$","div",null,{"className":"content-width","children":[["$","h3",null,{"children":"Competitor Analysis"}],["$","p",null,{"children":"I analyzed the three most common tools design students use to plan their degrees, focusing on their strengths and weaknesses. While each app had one or two strong core features, none supported the full journey needed. This reinforced survey feedback about the frustration of switching between multiple platforms."}]]}],["$","img",null,{"className":"greyborder child md:col-span-2 my-4 full","src":"/images/handbook/competitor.png"}]]}]
