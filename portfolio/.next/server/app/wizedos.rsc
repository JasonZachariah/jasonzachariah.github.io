5:["$","div",null,{"className":"space-y-4","id":"step2","children":[["$","h4",null,{"children":"Initial Notes"}],["$","div",null,{"className":"space-y-4 content-width","children":[["$","h3",null,{"children":"So, what were the issues with the old WizEdOS system?"}],["$","p",null,{"children":"After reviewing the initial website with the client, these were the main pain points that emerged:"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":[["$","div",null,{"className":"space-y-4 greyborder p-4","children":[["$","p",null,{"className":"caption-lg","children":"Inconsistent Branding"}],["$","p",null,{"children":"Many images on the website were random stock illustrations that failed to communicate the company's services. As a result, the site felt disjointed and gave off an unprofessional impression."}]]}],["$","div",null,{"className":"space-y-4 greyborder p-4","children":[["$","p",null,{"className":"caption-lg","children":"Confusing Page Setup"}],["$","p",null,{"children":"Important sections such as the booking form were placed in hard-to-access areas, making it difficult for users to locate key actions quickly."}]]}]]}],["$","p",null,{"children":"With a clear understanding of what needed improvement, I began the research and development phase."}]]}]
6:["$","div",null,{"className":"space-y-4","id":"step3","children":[["$","h4",null,{"children":"Creating the Flows"}],["$","div",null,{"className":"space-y-4 content-width","children":[["$","h3",null,{"children":"Treat the website layout like a conversation"}],["$","p",null,{"children":"To get a clearer idea of how to structure the website that would satisfy the client, I had them \"pitch\" me the WizEdOS service as if I were another business . Using this method, I was able to identify natural ways to group content, taking notes on major points and structuring them based on how the client explained the platform."}],["$","p",null,{"children":"This process allowed us to find what aspects of the website needed to be added, and how we should organize them by pages."}],["$","p",null,{"children":" From this, we identified two main user flows for the WizEdOS website: to encourage companies to book a meeting, and second, to showcase the four sub-services of WizEdOS."}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":["$","img",null,{"className":"greyborder child col-span-3 my-4 full","style":{"width":"100%"},"src":"/images/wizedos/InformationArchitecture.png"}]}],["$","div",null,{"className":"space-y-4","children":["$","p",null,{"children":"For the first flow, this was achieved by adding a CTA button in both the hero section and the navigation bar. This opened a pop-up modal, allowing users to access the booking flow easily without it disrupting the users flow like it did before"}]}],["$","img",null,{"className":"greyborder my-4 full","src":"/images/wizedos/HeroSection.png"}],["$","video",null,{"className":"greyborder full","preload":"auto","autoPlay":true,"loop":true,"muted":true,"playsInline":true,"children":["$","source",null,{"src":"/images/wizedos/WireFrame_to_Final.mp4","type":"video/mp4"}]}],["$","img",null,{"className":"greyborder my-4 full","src":"/images/wizedos/Styleguide.png"}]]}]
7:["$","div",null,{"className":"space-y-4","id":"step7","children":[["$","h4",null,{"children":"Reflection"}],["$","div",null,{"className":"space-y-4 greyborder p-4 content-width","children":[["$","p",null,{"className":"caption-lg","children":"1. Work with your client, not against them"}],["$","p",null,{"children":"Maintaining transparency and involving the client in design decisions helped minimize revisions later and ensured we were aligned on the final deliverables."}]]}],["$","div",null,{"className":"space-y-4 greyborder p-4 content-width","children":[["$","p",null,{"className":"caption-lg","children":"2. Seeing the Big Picture"}],["$","p",null,{"children":"Adapting the existing brand identity to a flexible design system helped create a cohesive and consistent brand. This helped the client understand the value of the design system and how it would benefit the company in the long run."}]]}]]}]
